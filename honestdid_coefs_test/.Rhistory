load_betas <- function(path, grades = c(3, 4, 5, 6, 7, 8)) {
setwd(path)
beta_list <- list()
for (g in grades) {
file_name <- paste0("beta_grade", g, ".csv")
beta_list[[paste0("beta", g)]] <- as.numeric(
read.csv(file_name, header = FALSE)$V1
)
}
return(beta_list)
}
